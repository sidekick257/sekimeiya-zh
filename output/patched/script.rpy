    $ StopMusic(fadeout=7)
    $ Pause(11.0)
    call final_credits from _call_final_credits
    jump after_credits

label final_credits:
    ## Called by the credits screen as well. Placed here so movie can be marked as read.
    $ DisableMenu()
    $ StopMusic(fadeout=2)
    $ Pause(2)
    play movie ("movies/final.webm")
    if not persistent.finished:
        $ renpy.pause(248.0, hard=True)
    else:
        $ renpy.pause(248.0, hard=False)
    stop movie
    $ EnableMenu()
    nvl clear
    with dissolve
    $ renpy.music.play('sounds/snowstorm.wav', channel='music', loop=True, fadein=5)
    window auto hide
    return

