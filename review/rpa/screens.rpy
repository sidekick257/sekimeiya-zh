        else:
            action SetVariable('gallery_current', gallery_current+1), SetVariable('gallery_shown', str(cg)+str(gallery_current))

transform tf_cover_art_panning:
    yalign 0.5
    subpixel True
    block:
        pause 2.0
        ease 5.0 yalign 0.0
        pause 2.0
        ease 10.0 yalign 1.0
        pause 2.0
        ease 5.0 yalign 0.5
        repeat

