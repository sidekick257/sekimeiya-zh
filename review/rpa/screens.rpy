        yanchor 1.0
        ypos 0.975
        at tf_slide_xpos(-1.5, 0.018)

        hbox:
            vbox:
                xsize width1
                text _("In-game")
            use monospaced_text(GetPlayTime('game', static=False))
        hbox:
            vbox:
                xsize width1
                text _("Search")
            use monospaced_text(GetPlayTime('search', static=False))
        hbox:
