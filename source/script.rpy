init python:
    ## Initializations
    hide_textbox_bg = False

    def CheckAllEndingsAchievement():
        #if not persistent.all_alt_endings:
        if persistent.end1 and persistent.end2 and persistent.end3 and persistent.end4 and persistent.end5 and persistent.forsaken and persistent.end7:
            persistent.all_alt_endings = True
            achievement.grant("alt_endings_complete")
            achievement.sync()
label after_load:
    play system "sounds/sys8.wav"
    return
label splashscreen:
    $ DisableMenu()
    $ StartupOperations()
    show bg black
    $ Pause(0.5)
    play movie ("movies/splashscreen.webm")
    $ renpy.pause(6, hard=True)
    stop movie
    show bg black
    with dissolve
    $ Pause(1)
    $ EnableMenu()
    return

label main_menu:
    if persistent.finished:
        $ renpy.music.play('sounds/snowstorm.wav', channel='music', loop=True, fadein=5)
    else:
        $ PlayMusic("roomwithnowindows")

    if persistent.tip_visibility and persistent.tip_visibility['example1']==1 or persistent.tip_visibility['example2']==1:
        # User quit before unlocking both examples, mark them as read so tip count is correct
        $ persistent.tip_visibility['example1'] = 2
        $ persistent.tip_visibility['example2'] = 2

    jump main_menu_screen

label start:
    if not persistent.started:
        $ DisableMenu()
    $ MapResetPositions()
    $ explanation=False
    $ Snow(0)
    $ chapter = 1
    $ SceneTitle("After Dark")
    $ UnlockNote("c1_001")
    nvl clear
    if persistent.finished:
        $ StopMusic()
    # Dissolve to black at the start can't be skipped by clicking
    $ DisableDismiss()
    show bg black
    # Only dissolve still images. The opening video restarts otherwise
    if persistent.mainmenu2 or persistent.mainmenu3 or persistent.mainmenu4 or persistent.mainmenu5 or persistent.mainmenu6:
        with slowdissolve
    $ EnableDismiss()
    $ Pause(3.0)
    $ StopMusic(fadeout=9)
    show bg 2011:
        truecenter  zoom 1.0 subpixel True
        ease 10.0 zoom 1.02
    with slowdissolve
    $ Pause(8.0)
    show bg black:
        truecenter  zoom 1.0 subpixel True
        ease 0 zoom 1.00
    with slowdissolve
