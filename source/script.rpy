    $ StopMusic(fadeout=7)
    $ Pause(11.0)
    call final_credits from _call_final_credits
    jump after_credits

label final_credits:
    ## Called by the credits screen as well. Placed here so movie can be marked as read.
    $ DisableMenu()
    $ StopMusic(fadeout=2)
    $ Pause(2)
    play movie ("movies/final.webm")
    if not persistent.finished:
        $ renpy.pause(248.0, hard=True)
    else:
        $ renpy.pause(248.0, hard=False)
    stop movie
    $ EnableMenu()
    nvl clear
    with dissolve
    $ renpy.music.play('sounds/snowstorm.wav', channel='music', loop=True, fadein=5)
    window auto hide
    return

label after_credits:
    $ Pause(2)
    $ MapSetPosition(0, 0, None)
    show bg outside9:
        truecenter zoom 1.05 subpixel True  ## To hide the vpunch borders
    $ Snow(1, fast=True)
    with slowdissolve
    $ Pause(0.5)
    play sound "sounds/doorlocked2.mp3"
    $ Pause(1)
    sai "Atsuki, you son of a bitch! Open the fucking door!"
    sai "I know you just left! I heard you talking with Shiroya! You better come back right now!"
    play sound "sounds/doorlocked2.mp3"
    $ Pause(1)
    sai "Atsuki! Piece of shit!"
    sai "I'll convince everyone this was all your doing if you don't open this fucking door!"
    play sound "sounds/doorlocked2.mp3"
    $ Pause(1)
    sai "At least tell the police we're here! I'm fucking hungry, man!"
    play sound "sounds/doorlocked4.wav"
    $ Pause(5)
    ak "...I don't think he's coming."
    sai "Can you just shut up?"
    sai "Atsuki! You think I won't tell them that you left with the Sekimeiya!? This is your last chance to come back!"
    nvl clear
    with dissolve
    play sound "sounds/doorlocked2.mp3"
    with vpunch
    $ Pause(0.5)
    saicenter "\"Atsuki!\"{w=1.1}{nw}"
    #sai "Atsuki!"
    $ Pause(0.8)
    nvl clear
    show bg black:
        zoom 1.00
    $ Snow(0, fast=True)
    with slowdissolve
    $ Pause(3)
    scene bg black
    $ ChapterEnd(5)
    if persistent.finished:
        return

